# Frontend environment configuration (Vite)
#
# Copy to `web/.env` if you need to override a default. Neither variable is
# required — the app works fully without this file.

# API base URL. Defaults to http://<current-hostname>:8000, which matches
# `make up` for local development.
# VITE_API_BASE=http://localhost:8000
#
# Only need a different port (e.g. a second API stack on :8001)? Set just the
# port — the host still follows the URL you opened, so it keeps working from
# other devices (phone over Tailscale) where "localhost" would be wrong.
# Ignored if VITE_API_BASE is set.
# VITE_API_PORT=8001

# Solana RPC endpoint used by the wallet-connect flow. Defaults to the
# public mainnet-beta endpoint if unset.
# VITE_SOLANA_RPC=https://api.mainnet-beta.solana.com
