# Optional EVM holdings provider. App runs without this key and falls back to Alchemy.
MORALIS_API_KEY=

# Ordered provider strategies.
CRYPTO_EVM_HOLDINGS_PROVIDERS=moralis,alchemy
CRYPTO_PRICE_PROVIDERS=defillama,coingecko

# Bounded provider behavior.
CRYPTO_PROVIDER_TIMEOUT_SECONDS=10
CRYPTO_ALCHEMY_MAX_ATTEMPTS=3
CRYPTO_ALCHEMY_MIN_INTERVAL_SECONDS=0
CRYPTO_MORALIS_MIN_INTERVAL_SECONDS=0
CRYPTO_HELIUS_MIN_INTERVAL_SECONDS=0
CRYPTO_TOKEN_METADATA_CACHE_TTL_SECONDS=86400
