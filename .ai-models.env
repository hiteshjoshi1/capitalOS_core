PLAN_MODEL=claude-sonnet-4.6
BUILD_MODEL=gpt-5.3-codex
REVIEW_MODEL=claude-sonnet-4.6
REVIEW_ESCALATION_MODEL=claude-opus-4.6
CODEX_TIMEOUT_MINUTES=60
ENABLE_CAFFEINATE=1
COPILOT_TOOL_MODE=tools-enabled
CONTEXT7_ENABLED=0
COPILOT_MCP_CONFIG=~/.copilot/mcp-config.json
MAX_RETRIES=3
NO_CACHE=0
ALLOWED_AUX_FILES=scripts/task_flow.sh
MAX_REWORK_CYCLES=3
BUILD_MAX_AUTOPILOT_CONTINUES="${BUILD_MAX_AUTOPILOT_CONTINUES:-12}"

# v3 pipeline changes that is efficienct for copilot
V3_PROVIDER=copilot
V3_MODEL=claude-sonnet-4.6
V3_AUTO_FIX_MODE=deterministic_only
V3_ENABLE_CAFFEINATE=1
# To run with Codex directly instead of Copilot:
# V3_PROVIDER=codex
# V3_MODEL=gpt-5.3-codex
