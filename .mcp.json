{
  "mcpServers": {
    "capitalos-postgres": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--network",
        "capitalos_default",
        "-e",
        "DATABASE_URI",
        "crystaldba/postgres-mcp",
        "--access-mode=restricted"
      ],
      "env": {
        "DATABASE_URI": "postgresql://capitalos:capitalos@postgres:5432/capitalos"
      }
    }
  }
}
